{
  "name": "riftcompass-electron",
  "private": true,
  "version": "0.3.17",
  "license": "MIT",
  "description": "RiftCompass desktop companion: champ-select scouting and live in-game coaching, reading the League client locally.",
  "author": "RiftCompass",
  "main": "dist-electron/electron/main.js",
  "overwolf": {
    "packages": [
      "overlay"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:1421 && npm run build:electron && cross-env ELECTRON_RENDERER_URL=http://localhost:1421 electron .",
    "dev:overwolf": "concurrently -k -n VITE,OW-ELECTRON \"npm:dev:renderer\" \"npm:dev:electron:overwolf\"",
    "dev:electron:overwolf": "npm run build:electron && node scripts/dev-overwolf.mjs",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-preload.mjs",
    "build": "node scripts/check-sensitive.mjs && npm run build:renderer && npm run build:electron",
    "typecheck": "node scripts/check-sensitive.mjs && tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && node scripts/build-win.mjs --win",
    "pack:dir": "npm run build && node scripts/build-win.mjs --dir --win",
    "release": "npm run build && node scripts/build-win.mjs --win --publish always",
    "preview": "vite preview",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@primno/dpapi": "^2.0.1",
    "@sentry/electron": "^7.18.0",
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@overwolf/ow-electron": "^42.7.1",
    "@overwolf/ow-electron-builder": "^26.9.2",
    "@overwolf/ow-electron-packages-types": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.1"
  }
}
